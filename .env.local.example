NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Required in production — a long random secret for hashing visitor IPs
# (rate limiting). Generate one with:  openssl rand -hex 32
IP_HASH_SALT=

# The public address of the website (sitemap, link previews on WhatsApp etc.)
NEXT_PUBLIC_SITE_URL=https://your-school-domain.in

# Optional — error monitoring. Leave blank to disable Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only needed to upload source maps at build time:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
